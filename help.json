{
  "title": "SUBMERGE",
  "children": [
    {
      "title": "Idea",
      "lines": [
        "Turns any input into",
        "a low, dark field:",
        "rumble, underground",
        "resonance, distant",
        "low thunder. Not a",
        "reverb: the attack",
        "and timbre dissolve."
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "1 MIX  dry <-> wet",
        "2 DEPTH how far the",
        "  sound is turned",
        "  into rumble",
        "3 TONE 30..120 Hz",
        "4 DECAY 0.3..25 s",
        "5 MOTION 6 BLUR",
        "7 FEEDBACK 8 DARK"
      ]
    },
    {
      "title": "Depth",
      "lines": [
        "0%: the source is",
        "  still recognisable,",
        "  with a dark field.",
        "100%: only its",
        "  envelope and energy",
        "  drive the field;",
        "  the source is gone."
      ]
    },
    {
      "title": "Feedback",
      "lines": [
        "DECAY: how long one",
        "  hit rings.",
        "FEEDBACK: how much",
        "  the field feeds",
        "  itself. 90% very",
        "  long, 100% almost",
        "  endless - but it",
        "  never runs away."
      ]
    },
    {
      "title": "Sink",
      "lines": [
        "Top-right pad toggles",
        "SINK (violet); the",
        "header says SINK.",
        "New input fades out,",
        "the field gets darker",
        "and lower and keeps",
        "going. Off: back to",
        "normal in ~2 s."
      ]
    },
    {
      "title": "Pads",
      "lines": [
        "While this screen is",
        "open the pads belong",
        "to SUBMERGE: only the",
        "top-right one is used.",
        "Back gives them back."
      ]
    }
  ]
}
