{
  "id": "submerge",
  "name": "SUBMERGE",
  "abbrev": "SUBMG",
  "version": "0.2.0",
  "description": "Turns any input into a low, dark field: the attack and timbre dissolve into sub rumble, underground resonance and slowly moving low-frequency ambience. DEPTH TONE DECAY MOTION BLUR FEEDBACK DARK and an equal-power MIX. Works in track slots and in Master FX",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "submerge.so",
  "component_type": "audio_fx",
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "audio_in": true,
    "audio_out": true,
    "midi_in": false,
    "midi_out": false,
    "chain_params": [
      {"key": "mix", "name": "Mix", "short_name": "MIX", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5, "unit": "%", "display_format": "%.0f"},
      {"key": "depth", "name": "Depth", "short_name": "DEPTH", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.7, "unit": "%", "display_format": "%.0f"},
      {"key": "tone", "name": "Tone", "short_name": "TONE", "type": "float", "min": 30, "max": 120, "step": 1, "default": 49, "unit": "Hz"},
      {"key": "decay", "name": "Decay", "short_name": "DECAY", "type": "float", "min": 0.3, "max": 25, "step": 0.1, "default": 3.4, "unit": "sec", "display_format": "%.1f"},
      {"key": "motion", "name": "Motion", "short_name": "MOTN", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.4, "unit": "%", "display_format": "%.0f"},
      {"key": "blur", "name": "Blur", "short_name": "BLUR", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5, "unit": "%", "display_format": "%.0f"},
      {"key": "feedback", "name": "Feedback", "short_name": "FDBK", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.35, "unit": "%", "display_format": "%.0f"},
      {"key": "dark", "name": "Dark", "short_name": "DARK", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.4, "unit": "%", "display_format": "%.0f"}
    ]
  }
}
